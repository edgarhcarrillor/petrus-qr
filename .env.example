# Copia este archivo a .env.local y completa los valores.
# En Vercel: Project → Settings → Environment Variables (las mismas claves).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡SECRETA! Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL que va DENTRO de los QR impresos (sin / final).
# Vacía = usa el dominio actual (localhost / *.vercel.app → solo pruebas).
# Cuando el dominio esté activo:  https://qr.petrustech.cl
NEXT_PUBLIC_QR_BASE_URL=

# Texto de la marca de agua en planos e imágenes.
NEXT_PUBLIC_WATERMARK_TEXT=Petrus Tech
